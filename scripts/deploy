#!/usr/bin/env bash
# Copies custom_components/powerocean_single_phase to a Home Assistant instance.
# Restart Home Assistant yourself afterwards, in the user interface.
#
# Requirement: the app "Terminal & SSH" or "Advanced SSH & Web Terminal"
# is installed and started in Home Assistant.
#
# Usage: scripts/deploy [address]   (without an address it asks for one)

set -e

cd "$(dirname "$0")/.."

HA_HOST="$1"
HA_PORT="22"

if [[ -z "${HA_HOST}" ]]; then
    read -r -p "Address of the Home Assistant instance: " HA_HOST
fi
if [[ -z "${HA_HOST}" ]]; then
    echo "No address given."
    exit 1
fi

read -r -p "User for ${HA_HOST}: " HA_USER
if [[ -z "${HA_USER}" ]]; then
    echo "No user given."
    exit 1
fi

echo "Branch: $(git branch --show-current) ($(git rev-parse --short HEAD))"
if [[ -n "$(git status --porcelain custom_components)" ]]; then
    echo "Note: uncommitted changes are copied too."
fi

echo "Copying to ${HA_USER}@${HA_HOST} ..."
# ssh asks for the password.
# Back up the old version to /config/powerocean_single_phase.bak, then
# unpack the new one.
tar -C custom_components --exclude=__pycache__ -cf - powerocean_single_phase \
    | ssh -p "${HA_PORT}" -o StrictHostKeyChecking=accept-new "${HA_USER}@${HA_HOST}" '
        set -e
        # The folders belong to root; other users need sudo without a password.
        # A function instead of a variable, because zsh does not split "$SUDO".
        run() {
            if [ "$(id -u)" -eq 0 ]; then "$@"; else sudo -n "$@"; fi
        }
        if [ "$(id -u)" -ne 0 ] && ! sudo -n true 2>/dev/null; then
            echo "sudo without a password is not possible - enter the user root in the SSH app."
            exit 1
        fi
        run mkdir -p /config/custom_components
        run rm -rf /config/powerocean_single_phase.bak
        if [ -d /config/custom_components/powerocean_single_phase ]; then
            run mv /config/custom_components/powerocean_single_phase /config/powerocean_single_phase.bak
        fi
        run tar -xf - -C /config/custom_components
    '

echo "Done. Now restart Home Assistant:"
echo "Settings -> System -> Restart (top right)"
