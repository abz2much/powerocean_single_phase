#!/usr/bin/env bash
# Measures how often the EcoFlow cloud updates the data of the system.
# Asks for the serial number, e-mail and password (not stored).
# Example: scripts/interval                       15 minutes, every 10 seconds
#           scripts/interval --minutes 120

set -e

cd "$(dirname "$0")/.."

.venv/bin/python scripts/interval.py "$@"
